// =============================================================================
// Zirve Tarım — Prisma Schema
// -----------------------------------------------------------------------------
// SPRINT 1: settings
// SPRINT 2: users, refresh_tokens, audit_logs (+ UserRole, AuditAction)
// SPRINT 3: categories, brands, plants, soil_types, benefits, side_effects,
//           usage_periods, unit_types (+ SideEffectSeverity, MeasurementType)
// SPRINT 4: products, product_categories, product_images, product_variants,
//           product_plants, product_soil_types, product_benefits,
//           product_side_effects, product_usage_periods, product_relations
//           (+ ProductRelationType)
// SPRINT 6: inquiries, inquiry_items, inquiry_status_histories
// SPRINT 8: customers, sales, sale_items, sale_additional_costs, payments
//           (+ CustomerType, SaleStatus, PaymentType, PaymentMethod)
// SPRINT 9: stock_movements
//           (+ StockMovementType, StockMovementDirection)
// SPRINT 11: customer_accounts, customer_refresh_tokens,
//            email_verification_tokens, password_reset_tokens,
//            carts, cart_items (+ inquiries.customerAccountId)
//
// Tam veri modeli (31 tablo) docs/prisma/schema.draft.prisma dosyasında taslak
// olarak hazırdır ve ilgili sprintlerde parça parça buraya taşınır:
//   Sprint 5 -> customers, requests, request_items
//   Sprint 5 -> sales, sale_items, stock_movements, document_counters
//   Sprint 6 -> payments, payment_allocations, customer_ledger_entries
//   Sprint 7 -> suppliers, purchases, expenses, cash_*
//
// Konvansiyonlar (docs/ARCHITECTURE.md §6.2):
//   - UUID id, createdAt, updatedAt her tabloda
//   - Tarihler UTC: @db.Timestamptz(6)
//   - Para: Decimal(18,4) | Miktar: Decimal(18,3) | Oran: Decimal(6,3)
//   - Soft delete (deletedAt) yalnız katalog/tanım tablolarında
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

/// Yönetim paneli rolleri — docs/ARCHITECTURE.md §8.
///
/// MVP'de yalnızca SUPER_ADMIN ve ADMIN kullanılır. Diğer roller enum'da
/// bulunur ki ileride personel ayrımı gerektiğinde migration'a gerek kalmasın;
/// RolesGuard bugün yalnız ilk ikisine yetki tanır.
enum UserRole {
  /// Her şey + geri alınamaz işlemler (satış/tahsilat iptali, stok düzeltme,
  /// kullanıcı yönetimi, ayarlar, audit log).
  SUPER_ADMIN

  /// Günlük operasyon: katalog, talep, satış, tahsilat, alış.
  ADMIN

  // --- Aşağıdakiler MVP'de KULLANILMIYOR (ileriye dönük ayrılmıştır) ---

  /// Şube/ekip sorumlusu.
  MANAGER

  /// Satış personeli.
  SALES_STAFF

  /// Depo personeli.
  WAREHOUSE_STAFF

  /// Muhasebe — finansal okuma ağırlıklı.
  ACCOUNTANT
}

/// Denetim kaydı eylem türleri.
enum AuditAction {
  CREATE
  UPDATE
  SOFT_DELETE
  RESTORE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  STATUS_CHANGE
  PASSWORD_CHANGE
  PRICE_CHANGE
  STOCK_ADJUST
  PAYMENT_RECORDED
  SALE_CANCELLED

  // --- Sprint 11: müşteri hesabı ---

  /// Müşteri e-postasını doğruladı. `UPDATE` ile aynı yere yazılabilirdi ama
  /// ayrı tutuldu: "hangi hesaplar doğrulandı" sorusu denetim kaydında tek
  /// başına filtrelenebilir olmalıdır — geçmiş talep bağlamanın önkoşuludur.
  EMAIL_VERIFIED

  /// Müşteri hesabı bir CRM müşteri kartına bağlandı veya bağ kaldırıldı.
  /// Satış/borç geçmişinin hangi hesaba göründüğünü değiştirir; izlenmesi
  /// gereken bir yetki olayıdır.
  ACCOUNT_LINKED
}

// =============================================================================
// KİMLİK & YETKİ
// =============================================================================

/// Yönetim paneli kullanıcısı. Public tarafta kullanıcı hesabı YOKTUR.
model User {
  id String @id @default(uuid()) @db.Uuid

  email        String  @db.VarChar(255)
  /// Argon2id hash. Ham şifre hiçbir yerde saklanmaz veya loglanmaz.
  passwordHash String  @db.VarChar(255)
  fullName     String  @db.VarChar(150)
  phone        String? @db.VarChar(30)

  role UserRole @default(ADMIN)

  /// Pasif kullanıcı giriş YAPAMAZ (iş kuralı). Silme yerine bu kullanılır.
  isActive Boolean @default(true)

  lastLoginAt DateTime? @db.Timestamptz(6)

  /// Kaba kuvvet koruması: ardışık başarısız deneme sayacı.
  failedLoginCount Int       @default(0)
  /// Bu tarihe kadar giriş reddedilir.
  lockedUntil      DateTime? @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  assignedInquiries    Inquiry[]              @relation("InquiryAssignedUser")
  inquiryStatusChanges InquiryStatusHistory[] @relation("InquiryStatusChangedBy")

  createdSales           Sale[]               @relation("SaleCreatedBy")
  cancelledSales         Sale[]               @relation("SaleCancelledBy")
  createdPayments        Payment[]            @relation("PaymentCreatedBy")
  createdAdditionalCosts SaleAdditionalCost[] @relation("AdditionalCostCreatedBy")

  createdStockMovements StockMovement[] @relation("StockMovementCreatedBy")
  createdCustomerNotes  CustomerNote[]  @relation("CustomerNoteCreatedBy")

  @@index([role, isActive])
  @@index([deletedAt])
  @@map("users")
}

/// Yenileme jetonu — HASH'lenmiş saklanır, tek kullanımlıktır (rotation).
///
/// Ham jeton yalnızca istemcide bulunur. Veritabanı ele geçse bile jetonlar
/// kullanılamaz (docs/ARCHITECTURE.md §11.1).
model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  /// Ham jetonun SHA-256 özeti. Ham değer ASLA saklanmaz.
  tokenHash String @unique @db.VarChar(64)

  /// Rotasyon zinciri: bu jeton hangi jetonun yerine üretildi.
  /// Yeniden kullanım tespitinde zincirin tamamı iptal edilir.
  replacedByTokenHash String? @db.VarChar(64)

  userAgent String? @db.VarChar(255)
  ipAddress String? @db.VarChar(64)

  expiresAt     DateTime  @db.Timestamptz(6)
  /// Dolu ise jeton artık kullanılamaz (kullanıldı, çıkış yapıldı veya iptal edildi).
  revokedAt     DateTime? @db.Timestamptz(6)
  /// İptal gerekçesi: ROTATED | LOGOUT | REUSE_DETECTED | USER_DEACTIVATED
  revokedReason String?   @db.VarChar(40)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Değişmez denetim kaydı.
///
/// Bu tabloda UPDATE ve DELETE veritabanı seviyesinde engellenir
/// (migration içindeki RULE'lar). Yalnız INSERT yapılır.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// Sistem tarafından üretilen kayıtlarda ve silinmiş kullanıcılarda null olabilir.
  userId String? @db.Uuid

  action     AuditAction
  entityType String      @db.VarChar(80)
  entityId   String?     @db.Uuid

  /// Değişiklik öncesi/sonrası. Hassas alanlar (passwordHash, token) maskelenir.
  oldData Json?
  newData Json?

  /// Serbest açıklama (ör. "Yetkisiz giriş denemesi").
  description String? @db.VarChar(500)

  ipAddress String? @db.VarChar(64)
  userAgent String? @db.VarChar(255)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// onDelete: NoAction ZORUNLUDUR — SetNull DEĞİL.
  ///
  /// SetNull, kullanıcı silinince audit_logs üzerinde bir UPDATE tetikler;
  /// bu tablo `audit_logs_no_update` RULE'u ile değişmez olduğu için Postgres
  /// "referential integrity query gave unexpected result" hatası verir.
  ///
  /// NoAction ile davranış açık ve doğru olur: denetim geçmişi olan bir
  /// kullanıcı hard delete EDİLEMEZ. Zaten uygulama soft delete kullanır.
  user User? @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// SİSTEM
// =============================================================================

/// Anahtar-değer sistem ayarları.
/// `isPublic = true` olanlar kimlik doğrulaması olmadan /public/settings ucundan döner.
model Setting {
  id String @id @default(uuid()) @db.Uuid

  /// Nokta ile gruplanmış benzersiz anahtar. Örn. "store.phone"
  key   String @unique @db.VarChar(120)
  value String @db.Text

  /// Okuma sırasında doğru tipe dönüştürmek için: string | number | boolean | json
  valueType String @default("string") @db.VarChar(20)

  /// Yönetim panelinde gruplama başlığı.
  group String @default("general") @db.VarChar(60)

  description String? @db.VarChar(300)

  /// true ise public uçtan döner. HASSAS AYARLAR İÇİN ASLA true YAPILMAZ.
  isPublic Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([group])
  @@index([isPublic])
  @@map("settings")
}

// =============================================================================
// KATALOG TAKSONOMİSİ (Sprint 3)
// -----------------------------------------------------------------------------
// Ürünün bağlanacağı tanım/taksonomi verileri. Hepsinde ortak desen:
//   - `slug` benzersiz, addan otomatik üretilir (Türkçe karakter dönüşümlü)
//   - `isActive` public görünürlüğü, `deletedAt` soft delete
//   - `sortOrder` yönetici tarafından belirlenen sıralama
// =============================================================================

/// Yan etkinin ciddiyeti. Ürün detayında uyarı rengini belirler.
enum SideEffectSeverity {
  /// Bilgilendirme düzeyi; önlem gerektirmez.
  LOW

  /// Dikkat edilmeli; koruyucu ekipman önerilir.
  MEDIUM

  /// Ciddi; koruyucu ekipman zorunlu, uygulama kuralları katı.
  HIGH

  /// Kritik; yanlış kullanım kalıcı zarar veya zehirlenme riski taşır.
  CRITICAL
}

/// Ölçü biriminin türü. Aynı türdeki birimler arasında dönüşüm yapılabilir.
enum MeasurementType {
  /// kg, g, ton
  WEIGHT

  /// litre, ml
  VOLUME

  /// adet
  COUNT

  /// paket, kutu, çuval, şişe, bidon — ambalaj birimleri
  PACKAGING

  /// metre — sulama borusu, örtü vb.
  LENGTH

  /// dekar, hektar — uygulama alanı
  AREA
}

/// Ürün kategorisi. `parentId` ile sınırsız derinlikte hiyerarşi kurulur.
///
/// İŞ KURALI: Bir kategori kendisinin veya kendi alt ağacının altına taşınamaz
/// (döngü engeli). Bu kural servis katmanında zorunlu tutulur — veritabanı
/// tek başına bunu ifade edemez.
model Category {
  id       String  @id @default(uuid()) @db.Uuid
  parentId String? @db.Uuid

  name        String  @db.VarChar(150)
  slug        String  @db.VarChar(180)
  description String? @db.Text
  imageUrl    String? @db.VarChar(500)
  /// Kategori ikonu — YÜKLENEN GÖRSEL.
  ///
  /// Önceden `icon String? @db.VarChar(60)` idi ve lucide ikon adı (ör.
  /// "sprout") tutuyordu. O alan panelde yazıldığı hâlde vitrinde HİÇ
  /// okunmuyordu: vitrin her kategoride sabit bir ikon basıyordu. Artık
  /// mağaza kendi görselini yüklüyor.
  ///
  /// `iconStorageKey` AYRI tutulur: anahtar sürücüye göreli kalıcı kimliktir,
  /// URL sürücüye göre değişir (yerel yol vs. CDN). Silmek ve sürücü
  /// değiştiğinde URL'i yeniden üretmek için anahtar gerekir.
  iconUrl        String? @db.VarChar(700)
  iconStorageKey String? @db.VarChar(500)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  metaTitle String? @db.VarChar(200)
  metaDesc  String? @db.VarChar(400)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  /// Restrict: altında kategori varken silinemez (K-03).
  parent            Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children          Category[]        @relation("CategoryTree")
  productCategories ProductCategory[]

  @@index([parentId, sortOrder])
  @@index([isActive, deletedAt])
  @@map("categories")
}

/// Ürün markası / üretici firma.
model Brand {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(150)
  slug        String  @db.VarChar(180)
  description String? @db.Text
  logoUrl     String? @db.VarChar(500)
  websiteUrl  String? @db.VarChar(500)
  /// Üretici ülke. Çiftçi için güven unsuru olabiliyor.
  country     String? @db.VarChar(80)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
  products  Product[]

  @@index([isActive, deletedAt])
  @@map("brands")
}

/// Bitki türü. Ürünler "hangi bitkide kullanılır" bilgisiyle bunlara bağlanır.
model Plant {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(120)
  slug        String  @db.VarChar(150)
  /// Latince adı. Ziraat mühendisleri için anlamlı.
  latinName   String? @db.VarChar(150)
  description String? @db.Text
  imageUrl    String? @db.VarChar(500)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime?      @db.Timestamptz(6)
  productPlants ProductPlant[]

  @@index([isActive, deletedAt])
  @@map("plants")
}

/// Toprak türü. Gübre ve toprak düzenleyici ürünlerin uygunluğu buna bağlanır.
model SoilType {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(120)
  slug        String  @db.VarChar(150)
  description String? @db.Text
  /// Tipik pH aralığı açıklaması. Örn. "6.5 - 7.5"
  phRange     String? @db.VarChar(40)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?         @db.Timestamptz(6)
  productSoilTypes ProductSoilType[]

  @@index([isActive, deletedAt])
  @@map("soil_types")
}

/// Ürünün sağladığı yarar. Örn. "Kök gelişimini destekler".
model Benefit {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(150)
  slug        String  @db.VarChar(180)
  description String? @db.Text
  /// Lucide ikon adı.
  icon        String? @db.VarChar(60)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?        @db.Timestamptz(6)
  productBenefits ProductBenefit[]

  @@index([isActive, deletedAt])
  @@map("benefits")
}

/// Ürünün olası yan etkisi. Ciddiyet seviyesi uyarı rengini belirler.
model SideEffect {
  id String @id @default(uuid()) @db.Uuid

  name        String             @db.VarChar(150)
  slug        String             @db.VarChar(180)
  description String?            @db.Text
  severity    SideEffectSeverity @default(LOW)
  /// Alınması gereken önlem. Ürün detayında uyarı olarak gösterilir.
  precaution  String?            @db.Text

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?           @db.Timestamptz(6)
  productSideEffects ProductSideEffect[]

  @@index([severity])
  @@index([isActive, deletedAt])
  @@map("side_effects")
}

/// Bitkinin gelişim/uygulama dönemi. Örn. "Çiçeklenme Öncesi".
model UsagePeriod {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(120)
  slug        String  @db.VarChar(150)
  description String? @db.Text

  /// Takvimsel sıra: dönemler doğal sırasıyla listelenmeli.
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)
  deletedAt           DateTime?            @db.Timestamptz(6)
  productUsagePeriods ProductUsagePeriod[]

  @@index([isActive, deletedAt])
  @@map("usage_periods")
}

/// Ölçü birimi.
///
/// `allowsDecimal` KRİTİKTİR: "2.5 kg" geçerli bir satış satırıdır ama
/// "2.5 adet" değildir. Satış ve stok modülleri miktar doğrulamasında bu
/// alanı kullanır (Sprint 5).
model UnitType {
  id String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(60)
  slug        String  @db.VarChar(80)
  description String? @db.Text

  /// Kısa gösterim. Örn. "kg", "lt", "ad"
  code String @db.VarChar(16)

  measurementType MeasurementType @default(COUNT)

  /// Ondalıklı miktar girilebilir mi? kg/litre için true, adet için false.
  allowsDecimal Boolean @default(false)

  /// Temel birime çevrim katsayısı. Örn. g -> kg için 0.001.
  /// Null ise dönüşüm tanımlı değildir.
  conversionFactor Decimal? @db.Decimal(18, 6)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?        @db.Timestamptz(6)
  productVariants ProductVariant[]

  @@index([measurementType])
  @@index([isActive, deletedAt])
  @@map("unit_types")
}

// =============================================================================
// ÜRÜN (Sprint 4)
// =============================================================================

/// Ürünler arası ilişki türü.
///
/// İKİ AİLE VARDIR ve saklama biçimleri FARKLIDIR:
///
///   SİMETRİK (COMPATIBLE, INCOMPATIBLE, SIMILAR)
///     "A, B ile uyumsuzdur" ifadesi "B, A ile uyumsuzdur" ile aynı şeydir.
///     TEK satır saklanır; `sourceProductId < targetProductId` kanonik
///     sıralaması DB CHECK ile zorunludur. Okuma iki yönü birden tarar.
///     Gerekçe: INCOMPATIBLE'ın tek yönlü kalması bir GÜVENLİK hatasıdır —
///     tank karışımı uyarısı iki ürünün de sayfasında görünmelidir.
///
///   YÖNLÜ (ALTERNATIVE, COMPLEMENTARY, RECOMMENDED_TOGETHER)
///     "A yerine B önerilir" ifadesi "B yerine A önerilir" DEĞİLDİR.
///     Pahalı bir ürünün alternatifi ucuz olabilir ama tersi mağazanın
///     istemeyeceği bir öneridir. Kaynak → hedef olarak saklanır.
enum ProductRelationType {
  /// Birlikte kullanılabilir (tank karışımına uygun). SİMETRİK.
  COMPATIBLE

  /// Birlikte KULLANILMAMALI. SİMETRİK. Güvenlik uyarısı üretir.
  INCOMPATIBLE

  /// Benzer ürün. SİMETRİK.
  SIMILAR

  /// Bunun yerine önerilen ürün. YÖNLÜ.
  ALTERNATIVE

  /// Tamamlayıcı ürün. YÖNLÜ.
  COMPLEMENTARY

  /// Birlikte alınması önerilen ürün. YÖNLÜ.
  RECOMMENDED_TOGETHER
}

/// Ürün.
///
/// FİYAT VE STOK ÜRÜNDE DEĞİL VARYASYONDADIR (`ProductVariant`): aynı gübre
/// 5 kg, 25 kg ve 1 ton ambalajlarda farklı fiyat ve stokla satılır.
model Product {
  id String @id @default(uuid()) @db.Uuid

  name             String  @db.VarChar(220)
  slug             String  @db.VarChar(250)
  shortDescription String? @db.VarChar(500)
  description      String? @db.Text

  brandId String? @db.Uuid

  // --- Tarımsal bilgiler ---
  /// Nasıl uygulanır. Örn. "Yapraktan püskürtme, 200-300 lt suya 100 ml"
  usageInstructions String? @db.Text
  /// İçerik / etken madde. Örn. "%20 N, %20 P2O5, %20 K2O"
  ingredients       String? @db.Text
  /// Saklama koşulları.
  storageConditions String? @db.Text
  /// Bakanlık ruhsat numarası (zirai ilaç ve gübrelerde).
  licenseNumber     String? @db.VarChar(100)

  // --- Yayın ayarları ---
  /// Kayıt aktif mi? Pasif ürün hiçbir yerde görünmez.
  isActive    Boolean @default(true)
  /// Public katalogda yayınlansın mı? Aktif ama yayınlanmamış ürün
  /// yalnız yönetim panelinde görünür (hazırlık aşamasındaki ürünler).
  isPublished Boolean @default(false)
  /// Fiyat public tarafta gösterilsin mi? false ise "Fiyat sorunuz".
  showPrice   Boolean @default(true)
  isFeatured  Boolean @default(false)
  isNew       Boolean @default(false)
  isPopular   Boolean @default(false)

  // --- SEO ---
  metaTitle String? @db.VarChar(200)
  metaDesc  String? @db.VarChar(400)

  sortOrder Int @default(0)
  viewCount Int @default(0)

  /// TÜREVİ ALAN: aramada kullanılan normalleştirilmiş metin.
  ///
  /// Türk kullanıcılar aksansız yazar: "gubre" araması "Gübre" ürününü
  /// bulmalıdır. PostgreSQL'in ILIKE'ı aksan duyarlıdır ve `unaccent`
  /// uzantısı Türkçe "ı" harfini doğru işlemez.
  ///
  /// Çözüm: ad + kısa açıklama + içerik + marka, `slugify()` ile
  /// normalleştirilip burada saklanır. Arama terimi de aynı işlevden
  /// geçirilir. Böylece "Gübre", "gubre", "GÜBRE" hepsi eşleşir.
  ///
  /// Tek yazıcı: ProductsService (create/update).
  searchText String @default("") @db.Text

  /// TÜREVİ ALAN: aktif varyasyonların en düşük satış fiyatı.
  ///
  /// Neden saklanıyor: fiyata göre SIRALAMA ve fiyat ARALIĞI filtresi
  /// ürün düzeyinde yapılır, fiyat ise varyasyondadır. Prisma ilişkili bir
  /// toplulaştırmaya (`MIN(variants.salePrice)`) göre sıralayamaz; bellekte
  /// sıralamak ise yalnız o sayfayı sıralar ve sayfalamayı YANLIŞ yapar.
  ///
  /// Tek yazıcı: `ProductPricingService.recalculate()`. Varyasyon her
  /// değiştiğinde aynı transaction içinde güncellenir (docs/ARCHITECTURE.md §13.1).
  minSalePrice Decimal? @db.Decimal(18, 4)
  maxSalePrice Decimal? @db.Decimal(18, 4)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)

  categories   ProductCategory[]
  images       ProductImage[]
  variants     ProductVariant[]
  plants       ProductPlant[]
  soilTypes    ProductSoilType[]
  benefits     ProductBenefit[]
  sideEffects  ProductSideEffect[]
  usagePeriods ProductUsagePeriod[]

  relationsAsSource ProductRelation[] @relation("RelationSource")
  relationsAsTarget ProductRelation[] @relation("RelationTarget")
  inquiryItems      InquiryItem[]
  saleItems         SaleItem[]
  stockMovements    StockMovement[]
  cartItems         CartItem[]

  @@index([brandId])
  @@index([isActive, isPublished, deletedAt])
  @@index([isFeatured, isActive])
  @@index([sortOrder])
  @@index([createdAt])
  @@index([minSalePrice])
  @@index([searchText])
  @@map("products")
}

/// Ürün–kategori bağlantısı.
///
/// Bir ürün birden çok kategoride bulunabilir ama YALNIZ BİRİ ana
/// kategoridir (`isPrimary`). Ana kategori kırılım (breadcrumb) ve
/// kanonik adres için kullanılır.
model ProductCategory {
  id String @id @default(uuid()) @db.Uuid

  productId  String @db.Uuid
  categoryId String @db.Uuid

  /// Ana kategori. Ürün başına EN FAZLA BİR tane olabilir (kısmi unique index).
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

/// Ürün görseli.
model ProductImage {
  id String @id @default(uuid()) @db.Uuid

  productId String @db.Uuid

  /// Depolama sürücüsünün döndürdüğü yol. Sürücü değişse de kayıt bozulmasın
  /// diye TAM URL değil göreli anahtar saklanır.
  storageKey String  @db.VarChar(500)
  url        String  @db.VarChar(700)
  altText    String? @db.VarChar(250)

  /// Orijinal dosya adı — yöneticiye gösterilir.
  originalName String? @db.VarChar(255)
  mimeType     String  @db.VarChar(100)
  sizeBytes    Int
  width        Int?
  height       Int?

  sortOrder Int     @default(0)
  /// Ana görsel. Ürün başına EN FAZLA BİR tane (kısmi unique index).
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

/// Ürün varyasyonu — satılabilir asıl birim.
///
/// Fiyat, stok ve SKU buradadır. "AgroMax NPK 20-20-20" bir üründür;
/// "5 kg çuval" ve "25 kg çuval" onun varyasyonlarıdır.
model ProductVariant {
  id String @id @default(uuid()) @db.Uuid

  productId  String @db.Uuid
  unitTypeId String @db.Uuid

  /// Stok kodu. TÜM ürünler arasında benzersizdir.
  sku  String  @db.VarChar(64)
  /// Varyasyon adı. Örn. "5 kg Çuval". Boşsa birim ve miktardan üretilir.
  name String? @db.VarChar(150)

  /// Ambalajdaki miktar. Örn. 5 kg çuval için 5.
  unitQuantity Decimal @db.Decimal(18, 3)

  // --- Fiyatlar (HASSAS: purchasePrice public'e ASLA sızmaz) ---
  purchasePrice Decimal @default(0) @db.Decimal(18, 4)
  salePrice     Decimal @default(0) @db.Decimal(18, 4)
  /// KDV oranı yüzde olarak. Örn. 20.000 = %20
  taxRate       Decimal @default(0) @db.Decimal(6, 3)

  // --- Sipariş miktarı kuralları ---
  /// Talep edilebilecek en az miktar.
  minOrderQuantity Decimal  @default(1) @db.Decimal(18, 3)
  /// Miktar bu adımın katları olmalıdır. Örn. 5 kg'lık çuval -> 5.
  quantityStep     Decimal  @default(1) @db.Decimal(18, 3)
  /// Talep edilebilecek en fazla miktar. Null ise sınırsız.
  maxOrderQuantity Decimal? @db.Decimal(18, 3)

  // --- Stok ---
  stockQuantity     Decimal @default(0) @db.Decimal(18, 3)
  lowStockThreshold Decimal @default(0) @db.Decimal(18, 3)
  /// false ise stok takibi yapılmaz (hizmet vb.).
  trackStock        Boolean @default(true)

  /// Varsayılan varyasyon. Ürün başına EN FAZLA BİR tane.
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  sortOrder Int @default(0)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitType       UnitType        @relation(fields: [unitTypeId], references: [id], onDelete: Restrict)
  inquiryItems   InquiryItem[]
  saleItems      SaleItem[]
  stockMovements StockMovement[]
  cartItems      CartItem[]

  @@index([productId, sortOrder])
  @@index([unitTypeId])
  @@index([isActive, deletedAt])
  @@index([salePrice])
  @@map("product_variants")
}

/// Ürün–bitki bağlantısı. "Bu ürün hangi bitkilerde kullanılır."
model ProductPlant {
  id String @id @default(uuid()) @db.Uuid

  productId String @db.Uuid
  plantId   String @db.Uuid

  /// Bu bitkiye özel doz/uygulama notu.
  note String? @db.VarChar(500)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  plant   Plant   @relation(fields: [plantId], references: [id], onDelete: Restrict)

  @@unique([productId, plantId])
  @@index([plantId])
  @@map("product_plants")
}

/// Ürün–toprak türü bağlantısı.
model ProductSoilType {
  id String @id @default(uuid()) @db.Uuid

  productId  String @db.Uuid
  soilTypeId String @db.Uuid

  note String? @db.VarChar(500)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  soilType SoilType @relation(fields: [soilTypeId], references: [id], onDelete: Restrict)

  @@unique([productId, soilTypeId])
  @@index([soilTypeId])
  @@map("product_soil_types")
}

/// Ürün–yarar bağlantısı.
model ProductBenefit {
  id String @id @default(uuid()) @db.Uuid

  productId String @db.Uuid
  benefitId String @db.Uuid

  /// Bu ürüne özel açıklama. Genel yarar tanımının yerine geçer.
  note      String? @db.VarChar(500)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  benefit Benefit @relation(fields: [benefitId], references: [id], onDelete: Restrict)

  @@unique([productId, benefitId])
  @@index([benefitId])
  @@map("product_benefits")
}

/// Ürün–yan etki bağlantısı.
model ProductSideEffect {
  id String @id @default(uuid()) @db.Uuid

  productId    String @db.Uuid
  sideEffectId String @db.Uuid

  /// Bu ÜRÜN için ciddiyet farklıysa buradan ezilir.
  /// Örn. "cilt tahrişi" genel olarak ORTA'dır ama derişik bir üründe YÜKSEK olabilir.
  severityOverride SideEffectSeverity?

  /// Bu ürüne özel önlem/açıklama.
  note      String? @db.VarChar(500)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sideEffect SideEffect @relation(fields: [sideEffectId], references: [id], onDelete: Restrict)

  @@unique([productId, sideEffectId])
  @@index([sideEffectId])
  @@map("product_side_effects")
}

/// Ürün–kullanım dönemi bağlantısı.
model ProductUsagePeriod {
  id String @id @default(uuid()) @db.Uuid

  productId     String @db.Uuid
  usagePeriodId String @db.Uuid

  note String? @db.VarChar(500)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  usagePeriod UsagePeriod @relation(fields: [usagePeriodId], references: [id], onDelete: Restrict)

  @@unique([productId, usagePeriodId])
  @@index([usagePeriodId])
  @@map("product_usage_periods")
}

/// Ürünler arası ilişki.
///
/// Saklama biçimi türe göre değişir — ayrıntı için `ProductRelationType`
/// enum'unun açıklamasına bakınız:
///   - SİMETRİK türlerde tek satır + `sourceProductId < targetProductId`
///     kanonik sıralaması (DB CHECK ile zorunlu)
///   - YÖNLÜ türlerde kaynak → hedef, sıralama kısıtı yok
model ProductRelation {
  id String @id @default(uuid()) @db.Uuid

  sourceProductId String              @db.Uuid
  targetProductId String              @db.Uuid
  type            ProductRelationType

  /// INCOMPATIBLE için ZORUNLU: neden birlikte kullanılmamalı.
  note String? @db.VarChar(500)

  sortOrder Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  sourceProduct Product @relation("RelationSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProduct Product @relation("RelationTarget", fields: [targetProductId], references: [id], onDelete: Cascade)

  @@unique([sourceProductId, targetProductId, type])
  @@index([targetProductId, type])
  @@index([sourceProductId, type])
  @@map("product_relations")
}

// =============================================================================
// TALEP (SEPET -> MAĞAZAYA TALEP)
// =============================================================================

/// Talebin geldiği kanal. MVP'de yalnız WEB kullanılır; kalanlar
/// mağaza içi ve telefon talepleri için hazır bekler.
enum InquirySource {
  WEB
  MOBILE
  PHONE
  IN_STORE
}

/// Talep durumu (SPEC §12).
///
/// Geçişler InquiryStatusService içindeki ALLOWED_TRANSITIONS tablosunda
/// tanımlıdır; uç durumlardan çıkış yoktur.
enum InquiryStatus {
  NEW
  REVIEWING
  CONTACTED
  QUOTED
  APPROVED
  /// Uç durum. Yalnız Sprint 8'in satışa dönüştürme akışı set eder.
  CONVERTED_TO_SALE
  /// Uç durum: satışa dönüşmeden kapandı.
  COMPLETED
  /// Uç durum: spam veya geçersiz talep.
  REJECTED
  /// Uç durum: müşteri vazgeçti.
  CANCELLED
}

/// Müşterinin tercih ettiği iletişim yolu.
enum PreferredContact {
  PHONE
  WHATSAPP
  EMAIL
}

model Inquiry {
  id            String        @id @default(uuid()) @db.Uuid
  inquiryNumber String        @unique @db.VarChar(32)
  status        InquiryStatus @default(NEW)
  source        InquirySource @default(WEB)

  // --- İletişim bilgisi SNAPSHOT ---
  //
  // Ziyaretçi giriş yapmadan talep açar; `customers` tablosu Sprint 7'de
  // gelecek. O zamana kadar iletişim bilgisi burada saklanır ve müşteri
  // kaydı oluşturulduğunda eşleştirilecektir.
  contactName      String           @db.VarChar(200)
  contactPhone     String           @db.VarChar(30)
  contactEmail     String?          @db.VarChar(255)
  city             String           @db.VarChar(80)
  district         String           @db.VarChar(80)
  address          String?          @db.VarChar(500)
  preferredContact PreferredContact @default(PHONE)

  /// Müşterinin talebe eklediği not.
  customerNote String? @db.Text
  /// Yalnız yönetici görür; public yanıtta ASLA dönmez.
  internalNote String? @db.Text

  // --- KVKK onayı ---
  //
  // Onay olmadan talep oluşturulamaz. Onayın kanıtı kaydın kendisidir:
  // zamanı ve isteğin IP'si birlikte saklanır.
  consentAccepted Boolean  @default(false)
  consentAt       DateTime @db.Timestamptz(6)

  /// Talep anındaki tahmini toplam. BİLGİ AMAÇLIDIR, bağlayıcı değildir;
  /// yalnız fiyatı gösterilebilen kalemlerden hesaplanır.
  currency       String  @default("TRY") @db.VarChar(3)
  estimatedTotal Decimal @default(0) @db.Decimal(18, 4)

  /// Spam analizi için.
  ipAddress String? @db.VarChar(64)
  userAgent String? @db.VarChar(255)

  assignedToId String? @db.Uuid

  /// Talep bir müşteriye bağlandıysa (satışa dönüşümde set edilir).
  ///
  /// Sprint 6'da bu alan YOKTU: `customers` tablosu henüz kurulmamıştı.
  /// Talep sahibinin iletişim bilgisi snapshot olarak talepte durur; bu
  /// bağ, dönüşümden sonra müşteri geçmişini izlemek için eklendi.
  customerId String? @db.Uuid

  /// Talebi GÖNDEREN public hesap (Sprint 11).
  ///
  /// `customerId` İLE KARIŞTIRILMAMALIDIR ve onun yerine geçmez:
  ///   customerId        -> mağazanın CRM kartı. Yönetici açar; satış ve
  ///                        borç buna yazılır.
  ///   customerAccountId -> ziyaretçinin kendi açtığı GİRİŞ hesabı. "Bu
  ///                        talebi kim gönderdi" sorusunun yanıtıdır ve
  ///                        `GET /customer/inquiries` yetkilendirmesinin
  ///                        TEK dayanağıdır.
  ///
  /// Talep hesapsız da gelebilir (misafir akışı bozulmaz), bu yüzden
  /// nullable. Hesap ile CRM kartı arasındaki bağ `customer_accounts.customerId`
  /// üzerindedir; iki alan bilinçli olarak birbirinden bağımsız tutulur —
  /// hesabı olmayan bir müşterinin talebi de, CRM kartı olmayan bir hesabın
  /// talebi de geçerli durumlardır.
  customerAccountId String? @db.Uuid

  contactedAt DateTime? @db.Timestamptz(6)
  closedAt    DateTime? @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  /// Kural 4: talep kaydı HARD DELETE edilmez.
  deletedAt DateTime? @db.Timestamptz(6)

  assignedTo      User?                  @relation("InquiryAssignedUser", fields: [assignedToId], references: [id], onDelete: SetNull)
  customer        Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerAccount CustomerAccount?       @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)
  items           InquiryItem[]
  statusHistories InquiryStatusHistory[]
  /// Bir talep en fazla bir satışa dönüşür (sales.inquiryId UNIQUE).
  sale            Sale?

  @@index([status, createdAt])
  @@index([contactPhone])
  @@index([assignedToId, status])
  @@index([customerId])
  @@index([deletedAt])
  /// "Taleplerim" listesi: hesap + tarih. Sprint 11'in en sık sorgusu.
  @@index([customerAccountId, createdAt])
  /// Doğrulanmış e-postayla geçmiş misafir taleplerini bulmak için.
  ///
  /// Bu indeksin çalışması `contactEmail`in KÜÇÜK HARFE normalleştirilmiş
  /// saklanmasına bağlıdır (Sprint 11 migration'ı mevcut satırları da
  /// düzeltir). `mode: 'insensitive'` ile aranırsa ILIKE üretilir ve indeks
  /// kullanılmaz — bu yüzden sorgu tam eşitlikle yazılır.
  @@index([contactEmail])
  @@map("inquiries")
}

model InquiryItem {
  id        String @id @default(uuid()) @db.Uuid
  inquiryId String @db.Uuid

  /// Ürün silinirse kayıt kalır, bağ kopar (SetNull). Snapshot alanları
  /// sayesinde talebin ne için açıldığı yine okunabilir (Kural 5).
  productId String? @db.Uuid
  variantId String? @db.Uuid

  // --- SNAPSHOT: talep anındaki ürün bilgisi ---
  productNameSnapshot  String  @db.VarChar(220)
  variantNameSnapshot  String? @db.VarChar(200)
  skuSnapshot          String  @db.VarChar(64)
  unitTypeSnapshot     String  @db.VarChar(50)
  unitQuantitySnapshot Decimal @db.Decimal(18, 3)

  /// Talep anında MÜŞTERİYE GÖSTERİLEN fiyat.
  ///
  /// `showPrice = false` olan üründe NULL kalır: müşteri fiyatı hiç
  /// görmediyse kayda fiyat yazmak, sonradan "bu fiyatı görmüştü"
  /// yanılgısı üretirdi.
  displayedPriceSnapshot Decimal? @db.Decimal(18, 4)

  quantity  Decimal  @db.Decimal(18, 3)
  /// Gösterilen fiyat üzerinden satır tutarı; fiyat gizliyse NULL.
  lineTotal Decimal? @db.Decimal(18, 4)

  note String? @db.VarChar(300)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  inquiry Inquiry         @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([inquiryId])
  @@index([productId])
  @@map("inquiry_items")
}

/// Durum değişikliği geçmişi.
///
/// Kural 4: silinmez. Her değişiklik ayrıca audit log'a da yazılır;
/// bu tablo yöneticiye zaman çizelgesi göstermek için okunur.
model InquiryStatusHistory {
  id        String @id @default(uuid()) @db.Uuid
  inquiryId String @db.Uuid

  /// İlk kayıtta NULL: talep yoktan NEW durumuna doğar.
  fromStatus InquiryStatus?
  toStatus   InquiryStatus

  note String? @db.VarChar(500)

  /// Public talep oluşturmada NULL (değiştiren bir yönetici yok).
  /// Kullanıcı silinemesin diye NoAction: geçmiş kaydı sahipsiz kalmaz.
  changedById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  inquiry   Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  changedBy User?   @relation("InquiryStatusChangedBy", fields: [changedById], references: [id], onDelete: NoAction)

  @@index([inquiryId, createdAt])
  @@map("inquiry_status_histories")
}

/// Yıl bazlı numara sayacı.
///
/// TLP-2026-000001 gibi numaraların ÇAKIŞMASIZ üretimi için. Numara,
/// talebi oluşturan transaction içinde `SELECT ... FOR UPDATE` ile
/// alınır: satır kilitlenir, sayaç artar, kilit commit'te bırakılır.
///
/// `MAX(numara)+1` yaklaşımı eşzamanlı iki istekte aynı numarayı üretir
/// ve unique kısıtı ikinci isteği hataya düşürürdü.
///
/// `scope` alanı, Sprint 7/8'deki satış (SAT) ve ödeme (ODM) numaraları
/// da aynı tabloyu kullanabilsin diye var.
model NumberSequence {
  id    String @id @default(uuid()) @db.Uuid
  scope String @db.VarChar(20)
  year  Int

  lastValue Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([scope, year])
  @@map("number_sequences")
}

// =============================================================================
// MÜŞTERİ
// =============================================================================
//
// ÖN KOŞUL İŞİ: Sprint 8 (satış) bir müşteriye bağlanmadan var olamaz.
// Sprint 7 çalıştırılmadığı için burada YALNIZ satışın gerektirdiği kadar
// müşteri modeli kuruldu. Adres defteri (customer_addresses) ve cari
// hesap defteri (customer_ledger_entries) BİLİNÇLİ OLARAK YOK.

enum CustomerType {
  INDIVIDUAL
  CORPORATE
}

model Customer {
  id   String       @id @default(uuid()) @db.Uuid
  /// İnsan tarafından okunan müşteri kodu: MUS-000001.
  code String       @unique @db.VarChar(40)
  type CustomerType @default(INDIVIDUAL)

  fullName    String  @db.VarChar(200)
  /// Kurumsal müşteride ticari unvan.
  companyName String? @db.VarChar(250)

  /// Normalleştirilmiş 10 haneli biçimde saklanır (5321234567).
  /// Mükerrer müşteri tespiti bu alandan yapılır.
  phone    String  @db.VarChar(30)
  altPhone String? @db.VarChar(30)
  email    String? @db.VarChar(255)

  /// TCKN (bireysel) veya VKN (kurumsal).
  taxNumber String? @db.VarChar(20)
  taxOffice String? @db.VarChar(120)

  city     String? @db.VarChar(80)
  district String? @db.VarChar(80)
  address  String? @db.VarChar(500)

  /// Kredi limiti. Vadeli satışta borç bu limiti aşarsa UYARI üretilir;
  /// satış ENGELLENMEZ — kararı mağaza sahibi verir.
  creditLimit    Decimal @default(0) @db.Decimal(18, 4)
  /// Sisteme geçiş devir bakiyesi. Pozitif = müşteri borçlu.
  openingBalance Decimal @default(0) @db.Decimal(18, 4)

  note     String? @db.Text
  isActive Boolean @default(true)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  /// Kural 4: finansal geçmişi olan müşteri hard delete edilmez.
  deletedAt DateTime? @db.Timestamptz(6)

  sales     Sale[]
  payments  Payment[]
  inquiries Inquiry[]
  notes     CustomerNote[]

  /// Bağlı public giriş hesabı — EN FAZLA BİR (customer_accounts.customerId UNIQUE).
  account CustomerAccount?

  @@index([phone])
  @@index([isActive, deletedAt])
  @@index([fullName])
  @@map("customers")
}

/// Müşteri görüşme notu — tarihli kayıt zinciri.
///
/// `customers.note` alanından FARKLIDIR ve onun yerini almaz: o alan
/// müşteriyle ilgili kalıcı bir bilgidir ("kapıda ödeme istiyor"),
/// buradaki kayıtlar ise ZAMANA BAĞLI görüşme geçmişidir ("14 Mart:
/// gübre fiyatı sordu, düşünecek"). İkisi tek alanda tutulsaydı ya not
/// sürekli üzerine yazılır ya da hiç okunmayan bir metin yığınına dönerdi.
model CustomerNote {
  id String @id @default(uuid()) @db.Uuid

  customerId String @db.Uuid

  body String @db.Text

  /// Kullanıcı silinirse not kalır, yazarı düşer.
  createdById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("CustomerNoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@map("customer_notes")
}

// =============================================================================
// MÜŞTERİ HESABI — PUBLIC GİRİŞ (Sprint 11)
// -----------------------------------------------------------------------------
//
// KARAR: kimlik doğrulama alanları `customers` tablosuna EKLENMEDİ; ayrı bir
// hesap tablosu tutuluyor.
//
// GEREKÇE (üç bağımsız neden):
//
//   1. HESAPSIZ MÜŞTERİ NORMDUR. Mağazanın müşterilerinin büyük bölümü
//      tezgahta tanışılmış çiftçilerdir; kartlarını yönetici açar. `customers`
//      üzerine `email UNIQUE` + `passwordHash NOT NULL` konulsaydı ya bütün
//      alanlar nullable olurdu (kısıt kaybı: iki kartın aynı e-postayı
//      taşımasını hiçbir şey engellemezdi) ya da her CRM kartı için sahte
//      şifre üretmek gerekirdi.
//
//   2. GEÇMİŞİN KORUNMASI. Bir ziyaretçi kayıt olduğunda mağazada ADI VARSA
//      onun kartı zaten mevcuttur ve satış/borç geçmişi ona yazılıdır. Hesap
//      sonradan o karta bağlanır (`customerId`), geçmiş yerinde kalır. Tek
//      tabloda bu "iki satırı birleştirme" işlemi olurdu: finansal kayıtların
//      yabancı anahtarlarını taşımak gerekir ve geri alınamaz.
//
//   3. YAŞAM DÖNGÜLERİ AYRIDIR. Hesap kendini pasife alabilir/şifresini
//      değiştirebilir; CRM kartı yalnız yönetici tarafından yönetilir. Aynı
//      satırda iki farklı yetki alanı tutmak, "müşteri kendi kredi limitini
//      güncelleyebilir mi" gibi cevaplanması gerekmeyen sorular üretirdi.
//
// KARDİNALİTE: 1 hesap <-> EN FAZLA 1 müşteri kartı (`customerId` UNIQUE).
// Çoğa çok bağ, borcun hangi hesapta göründüğünü belirsiz kılardı.
// =============================================================================

/// Public tarafın giriş hesabı. Yönetim paneline ERİŞEMEZ (jeton audience'ı
/// ayrıdır — docs/ARCHITECTURE.md §8.4).
model CustomerAccount {
  id String @id @default(uuid()) @db.Uuid

  /// Bağlı CRM müşteri kartı. Boş olabilir: kayıt olan herkesin mağazada
  /// kartı yoktur. Bağlama yalnız yönetici tarafından yapılır (Sprint 11
  /// şartı 5) — otomatik eşleştirme hesap ele geçirme riski taşır.
  customerId String? @unique @db.Uuid

  /// Küçük harfe normalleştirilmiş biçimde saklanır (giriş anahtarı).
  email String @db.VarChar(255)

  /// 10 haneli normalleştirilmiş biçim (5321234567), `customers.phone` ile aynı.
  ///
  /// UNIQUE DEĞİLDİR ve olmamalıdır: aile içinde tek hat paylaşılır. Telefon
  /// bu sprintte kimlik doğrulama unsuru DEĞİL, iletişim bilgisidir.
  phone String @db.VarChar(30)

  firstName String @db.VarChar(100)
  lastName  String @db.VarChar(100)

  /// Argon2id hash — `users.passwordHash` ile aynı parametreler.
  passwordHash String @db.VarChar(255)

  /// E-posta doğrulandığı an. NULL ise hesap doğrulanmamıştır.
  ///
  /// KAPSAMI: doğrulama girişi ENGELLEMEZ (kullanıcı sepetine ulaşabilsin),
  /// ama GEÇMİŞ MİSAFİR TALEPLERİNİN hesaba bağlanması için ZORUNLUDUR.
  /// Aksi hâlde başkasının e-postasıyla kayıt olan biri o kişinin talep
  /// geçmişini okuyabilirdi.
  emailVerifiedAt DateTime? @db.Timestamptz(6)

  /// Pasif hesap giriş YAPAMAZ.
  isActive Boolean @default(true)

  lastLoginAt DateTime? @db.Timestamptz(6)

  /// Kaba kuvvet koruması — `users` tablosundaki desenin aynısı.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime? @db.Timestamptz(6)

  /// KVKK onayının kanıtı: kayıt anı ve isteğin IP'si.
  /// Onay olmadan hesap oluşturulamaz (`inquiries.consentAt` ile aynı desen).
  consentAt        DateTime @db.Timestamptz(6)
  consentIpAddress String?  @db.VarChar(64)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  /// Hesap silme talebinde (KVKK) soft delete edilir; talep geçmişi
  /// mağazanın ticari kaydı olduğu için silinmez.
  deletedAt DateTime? @db.Timestamptz(6)

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  refreshTokens      CustomerRefreshToken[]
  verificationTokens EmailVerificationToken[]
  resetTokens        PasswordResetToken[]
  cart               Cart?
  inquiries          Inquiry[]

  @@index([isActive, deletedAt])
  @@index([phone])
  @@map("customer_accounts")
}

/// Müşteri hesabının yenileme jetonu.
///
/// `refresh_tokens` ile AYNI yapıdadır ama AYRI TABLODUR: tek tabloda
/// `userId` ve `customerAccountId`in ikisi de nullable olurdu ve "tam olarak
/// biri dolu" kuralı yalnız CHECK ile ifade edilebilirdi. Ayrı tablo, yanlış
/// kimliğe jeton üretilmesini yabancı anahtar seviyesinde imkânsız kılar.
model CustomerRefreshToken {
  id String @id @default(uuid()) @db.Uuid

  customerAccountId String @db.Uuid

  /// Ham jetonun SHA-256 özeti. Ham değer ASLA saklanmaz.
  tokenHash String @unique @db.VarChar(64)

  /// Rotasyon zinciri — yeniden kullanım tespitinde zincirin tamamı iptal edilir.
  replacedByTokenHash String? @db.VarChar(64)

  userAgent String? @db.VarChar(255)
  ipAddress String? @db.VarChar(64)

  expiresAt     DateTime  @db.Timestamptz(6)
  revokedAt     DateTime? @db.Timestamptz(6)
  /// ROTATED | LOGOUT | REUSE_DETECTED | ACCOUNT_DEACTIVATED | PASSWORD_CHANGED
  revokedReason String?   @db.VarChar(40)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([customerAccountId, revokedAt])
  @@index([expiresAt])
  @@map("customer_refresh_tokens")
}

/// E-posta doğrulama jetonu — TEK KULLANIMLIK, SÜRELİ, HASH'Lİ.
///
/// Üç özellik de zorunludur:
///   hash'li  -> veritabanı sızsa bile bağlantılar kullanılamaz
///   süreli   -> eski bir e-postadaki bağlantı sonsuza kadar geçerli olmamalı
///   tek kullanımlık -> `usedAt` dolduktan sonra aynı bağlantı çalışmaz
model EmailVerificationToken {
  id String @id @default(uuid()) @db.Uuid

  customerAccountId String @db.Uuid

  /// Doğrulanacak adres.
  ///
  /// Hesabın `email` alanından AYRI tutulur: e-posta DEĞİŞİKLİĞİ akışında
  /// jeton YENİ adrese üretilir, hesabın adresi ise ancak jeton kullanılınca
  /// güncellenir. Aksi hâlde yanlış yazılmış bir adres hesabı erişilemez
  /// hâle getirirdi.
  email String @db.VarChar(255)

  /// Ham jetonun SHA-256 özeti.
  tokenHash String @unique @db.VarChar(64)

  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([customerAccountId, usedAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// Şifre sıfırlama jetonu — TEK KULLANIMLIK, SÜRELİ, HASH'Lİ.
/// Ömrü doğrulama jetonundan KISADIR (bkz. CustomerAuthModule sabitleri).
model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid

  customerAccountId String @db.Uuid

  tokenHash String @unique @db.VarChar(64)

  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)

  /// Talebin geldiği IP — kötüye kullanım incelemesi için.
  requestIpAddress String? @db.VarChar(64)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([customerAccountId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// =============================================================================
// SUNUCU TARAFI SEPET (Sprint 11)
// -----------------------------------------------------------------------------
//
// Misafir sepeti localStorage'da kalır (Sprint 6 akışı DEĞİŞMEZ). Bu tablolar
// yalnız GİRİŞLİ müşterinin sepetini taşır; amaç cihaz değiştirdiğinde
// listesini kaybetmemesidir.
//
// SNAPSHOT ALANI YOKTUR — talep kalemlerinden (`inquiry_items`) farkı budur.
// Sepet bir BEYAN DEĞİL, çalışma listesidir: ürün adı ve fiyat her okumada
// katalogdan güncel hâliyle çekilir. Talep gönderildiği anda snapshot alınır
// ve o kayıt dondurulur (Kural 5).
// =============================================================================

/// Girişli müşterinin sepeti — hesap başına EN FAZLA BİR.
model Cart {
  id String @id @default(uuid()) @db.Uuid

  customerAccountId String @unique @db.Uuid

  /// SON UYGULANAN BİRLEŞTİRME İSTEĞİNİN PARMAK İZİ (SHA-256).
  ///
  /// NEDEN VAR — iki şart aynı anda karşılanmak zorunda (Sprint 11 şartı 2):
  ///   (a) "Aynı varyasyon iki sepette de varsa miktarlar TOPLANIR"
  ///   (d) "Merge İDEMPOTENT: aynı payload ikinci kez gönderilirse sonuç
  ///        değişmez"
  ///
  /// Bu ikisi durumsuz bir birleştirmede ÇELİŞİR: toplama işlemi idempotent
  /// değildir. Sunucuda 5, misafirde 3 varsa sonuç 8'dir; aynı istek yeniden
  /// gelirse toplama 11 üretir. `max` alsaydık idempotent olurdu ama (a)
  /// sağlanmazdı — ilk birleştirmede de 5 kalırdı.
  ///
  /// Çözüm: toplama yapılır, ama UYGULANMIŞ İSTEK HATIRLANIR. Aynı parmak
  /// izine sahip ikinci istek hiçbir yazma yapmaz ve mevcut sepeti döner.
  /// İstemci başarılı birleştirmeden sonra yerel sepeti temizlediği için bu
  /// yol normalde yalnız AĞ TEKRARLARINDA (çift tıklama, yeniden deneme)
  /// devreye girer — asıl koruduğu durum da budur.
  ///
  /// Kullanıcı gerçekten aynı miktarı ikinci kez eklemek isterse sepet
  /// uçlarını (`POST /customer/cart/items`) kullanır; orada toplama her
  /// çağrıda uygulanır.
  lastMergeFingerprint String? @db.VarChar(64)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  items           CartItem[]

  @@map("carts")
}

/// Sepet kalemi.
///
/// `productId` varyasyondan türetilebilir ama DENORMALİZE tutulur: sepet
/// okuması ürün bazlı gruplama ve görsel çekimi yaparken fazladan bir join
/// kurmasın. Tutarlılık uygulama katmanında sağlanır (tek yazıcı: CartService).
model CartItem {
  id String @id @default(uuid()) @db.Uuid

  cartId           String @db.Uuid
  productId        String @db.Uuid
  productVariantId String @db.Uuid

  quantity Decimal @db.Decimal(18, 3)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  /// Aynı varyasyon sepette İKİ KEZ bulunamaz. Birleştirme (merge) ve
  /// "sepete ekle" akışlarının idempotency güvencesi budur.
  @@unique([cartId, productVariantId])
  @@index([productVariantId])
  @@map("cart_items")
}

// =============================================================================
// SATIŞ
// =============================================================================

/// Satış durumu.
///
/// TEK ALAN KARARI: yaşam döngüsü ve ödeme durumu AYRI alanlar değil, tek
/// enum. Sprint 8 şartı "ödeme sonrası durum otomatik: kısmi ->
/// PARTIALLY_PAID, tamamı -> PAID" diyor; iki ayrı alan tutulsaydı arayüzde
/// hangi rozetin gösterileceği belirsiz kalır ve iki alan ayrışabilirdi.
///
/// Akış: DRAFT -> CONFIRMED -> PARTIALLY_PAID -> PAID
/// Yan çıkış: DRAFT/CONFIRMED/PARTIALLY_PAID -> CANCELLED
/// PAID satış iptal edilemez: iade akışı bu sprintte yok.
enum SaleStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

/// Satışın peşin mi vadeli mi olduğunu belirtir.
enum PaymentType {
  /// Peşin: ödeme satış anında alınır.
  CASH
  /// Vadeli: borç doğar, vade tarihi zorunludur.
  CREDIT
}

/// Tahsilatın alınma yöntemi.
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  CHECK
  PROMISSORY_NOTE
  /// Mahsup: karşılıklı borç kapatma.
  OFFSET
}

model Sale {
  id         String @id @default(uuid()) @db.Uuid
  saleNumber String @unique @db.VarChar(32)
  customerId String @db.Uuid

  /// Talepten dönüştüyse kaynağı.
  ///
  /// UNIQUE: bir talep EN FAZLA BİR satışa dönüşür. İdempotency'nin son
  /// güvencesi budur — eşzamanlı iki dönüşüm isteğinde ikincisi
  /// veritabanı seviyesinde reddedilir.
  inquiryId String? @unique @db.Uuid

  status      SaleStatus  @default(DRAFT)
  paymentType PaymentType @default(CASH)

  /// Çoklu para birimine hazırlık; MVP'de daima TRY.
  currency String @default("TRY") @db.VarChar(3)

  // --- Tutarlar: SaleCalculationService tarafından hesaplanır ---
  //
  // Hepsi TÜRETİLMİŞ alandır. Tek yazar SaleCalculationService'tir ve
  // her zaman kalem/ödeme/ek maliyet değişikliğiyle AYNI transaction
  // içinde güncellenir (ARCHITECTURE §13.1).
  subtotal      Decimal @default(0) @db.Decimal(18, 4)
  discountTotal Decimal @default(0) @db.Decimal(18, 4)
  /// MVP'de daima 0 (KDV kapsam dışı).
  taxTotal      Decimal @default(0) @db.Decimal(18, 4)
  grandTotal    Decimal @default(0) @db.Decimal(18, 4)

  paidTotal      Decimal @default(0) @db.Decimal(18, 4)
  remainingTotal Decimal @default(0) @db.Decimal(18, 4)

  /// HASSAS ALANLAR — Kural 8: public yanıta ASLA sızmaz.
  costTotal           Decimal @default(0) @db.Decimal(18, 4)
  additionalCostTotal Decimal @default(0) @db.Decimal(18, 4)
  grossProfit         Decimal @default(0) @db.Decimal(18, 4)
  netProfit           Decimal @default(0) @db.Decimal(18, 4)

  saleDate DateTime  @db.Timestamptz(6)
  /// Vadeli satışta ZORUNLU (uygulama katmanında denetlenir).
  dueDate  DateTime? @db.Timestamptz(6)
  note     String?   @db.Text

  createdById   String    @db.Uuid
  confirmedAt   DateTime? @db.Timestamptz(6)
  cancelledById String?   @db.Uuid
  cancelledAt   DateTime? @db.Timestamptz(6)
  /// İptalde ZORUNLU.
  cancelReason  String?   @db.VarChar(500)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  customer        Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  inquiry         Inquiry?             @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  createdBy       User                 @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy     User?                @relation("SaleCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  items           SaleItem[]
  payments        Payment[]
  additionalCosts SaleAdditionalCost[]

  @@index([customerId, saleDate])
  @@index([status, saleDate])
  @@index([status, dueDate])
  @@index([saleDate])
  @@map("sales")
}

model SaleItem {
  id     String @id @default(uuid()) @db.Uuid
  saleId String @db.Uuid

  /// Ürün silinirse bağ kopar, snapshot kalır (Kural 5).
  productId String? @db.Uuid
  variantId String? @db.Uuid

  // --- SNAPSHOT: satış anındaki ürün bilgisi (Kural 5) ---
  productNameSnapshot String  @db.VarChar(220)
  variantNameSnapshot String? @db.VarChar(200)
  skuSnapshot         String  @db.VarChar(64)
  unitTypeSnapshot    String  @db.VarChar(50)

  quantity Decimal @db.Decimal(18, 3)

  /// HASSAS: satış anındaki birim ALIŞ fiyatı snapshot'ı.
  ///
  /// MALİYET YÖNTEMİ KARARI: ağırlıklı ortalama DEĞİL, satış anındaki
  /// varyasyon alış fiyatı. Sprint 8 şartı "kalem eklenirken varyasyonun
  /// O ANKİ alış/satış fiyatı kopyalanır" diyor. Ağırlıklı ortalama, alış
  /// (purchases) modülü gelmeden hesaplanamaz; o modül geldiğinde bu alan
  /// yerine ortalama maliyet yazılabilir, kayıt yapısı değişmez.
  unitPurchasePrice Decimal @db.Decimal(18, 4)
  unitSalePrice     Decimal @db.Decimal(18, 4)

  /// Satır bazında indirim TUTARI (yüzde değil).
  discountAmount Decimal @default(0) @db.Decimal(18, 4)

  /// Satış anındaki KDV oranı — SNAPSHOT (SPEC §15.16).
  ///
  /// KURAL: oran > 0 ise `unitSalePrice` KDV DAHİLDİR ve vergi ters hesapla
  /// ayrıştırılır; oran 0 ise kalem KDV'sizdir. Ürünün KDV oranı sonradan
  /// değişse bile geçmiş satış DEĞİŞMEMELİDİR, bu yüzden varyasyondan
  /// join'lenmez, kopyalanır.
  taxRate Decimal @default(0) @db.Decimal(6, 3)

  /// unitSalePrice * quantity (indirim düşülmemiş, KDV dahil).
  lineSubtotal Decimal @db.Decimal(18, 4)
  /// lineSubtotal - discountAmount.
  lineTotal    Decimal @db.Decimal(18, 4)

  /// HASSAS: unitPurchasePrice * quantity.
  lineCost   Decimal @db.Decimal(18, 4)
  /// `lineTotal` içinden ayrışan KDV payı. Oran 0 ise sıfırdır.
  lineTax    Decimal @default(0) @db.Decimal(18, 4)
  /// HASSAS: NET kâr — (lineTotal - lineTax) - (lineCost - alışKDV).
  /// KDV mağazanın parası olmadığı için ciroya yazılmaz.
  lineProfit Decimal @db.Decimal(18, 4)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  sale    Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([saleId, sortOrder])
  @@index([productId])
  /// Sprint 10: kâr raporunun ürün kırılımı kalemleri ürüne göre gruplayıp
  /// satışa join'ler; bu ikili indeks join ve grubu birlikte karşılar.
  @@index([productId, saleId])
  @@map("sale_items")
}

/// Satışa sonradan eklenebilen maliyetler: nakliye, kargo, komisyon, işçilik.
///
/// Finalize SONRASINDA da eklenebilir; netProfit aynı transaction içinde
/// yeniden hesaplanır.
model SaleAdditionalCost {
  id     String @id @default(uuid()) @db.Uuid
  saleId String @db.Uuid

  costType    String  @db.VarChar(50)
  description String? @db.VarChar(300)
  amount      Decimal @db.Decimal(18, 4)

  createdById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  sale      Sale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AdditionalCostCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@map("sale_additional_costs")
}

// =============================================================================
// ÖDEME (TAHSİLAT)
// =============================================================================

model Payment {
  id            String @id @default(uuid()) @db.Uuid
  paymentNumber String @unique @db.VarChar(32)

  /// Ödemeler SATIŞ BAZLIDIR.
  ///
  /// Serbest avans (satışa bağlı olmayan tahsilat) ve çoklu satışa dağıtım
  /// bu sprintte YOK: Sprint 8 şartı ödemeyi `POST /admin/sales/:id/payments`
  /// altında tanımlıyor. Avans gerektiğinde ayrı bir tablo eklenecek;
  /// buradaki kayıt yapısı değişmez.
  saleId     String @db.Uuid
  /// Satıştan türetilir ama DENORMALİZE tutulur: müşteri bazlı ödeme
  /// listesi ve finans özeti join'siz çalışsın.
  customerId String @db.Uuid

  method PaymentMethod
  amount Decimal       @db.Decimal(18, 4)

  currency String @default("TRY") @db.VarChar(3)

  paymentDate DateTime  @db.Timestamptz(6)
  /// Çek/senet vade tarihi.
  dueDate     DateTime? @db.Timestamptz(6)
  /// Çek/senet numarası, havale referansı vb.
  reference   String?   @db.VarChar(120)
  note        String?   @db.Text

  createdById String @db.Uuid

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  /// Kural 4: ödeme kaydı HARD DELETE EDİLMEZ. Hatalı ödeme soft delete
  /// edilir ve satış toplamları aynı transaction içinde düzeltilir.
  deletedAt DateTime? @db.Timestamptz(6)

  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User     @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([customerId, paymentDate])
  @@index([method, paymentDate])
  @@index([paymentDate])
  @@index([deletedAt])
  /// Sprint 10: her finans raporu "silinmemiş + tarih aralığı" ile tarar.
  /// Ayrı `deletedAt` ve `paymentDate` indeksleri bu ikiliyi tek geçişte
  /// karşılayamıyordu.
  @@index([deletedAt, paymentDate])
  @@map("payments")
}

// =============================================================================
// STOK (Sprint 9)
// =============================================================================

/// Stok hareketinin yönü.
///
/// Miktar DAİMA POZİTİFTİR; işareti bu alan taşır (K-58). İşaretli miktar
/// saklansaydı "toplam çıkış" gibi her rapor, işaret filtresini doğru
/// kurmaya bağımlı olurdu; yön ayrı alanda tutulunca sorgu hem okunur hem
/// indekslenebilir olur.
enum StockMovementDirection {
  IN
  OUT
}

/// Stok hareketinin nedeni.
///
/// SALE ve SALE_CANCEL'ı YALNIZ sistem üretir (satış onayı/iptali);
/// `POST /admin/stock/adjustment` bunları reddeder. Diğer tipler elle
/// girilir ve açıklama zorunludur.
enum StockMovementType {
  /// Açılış stoğu — varyasyon ilk oluşturulduğunda.
  INITIAL
  /// Alış / tedarikçiden mal girişi.
  PURCHASE
  /// Satış onayı — stok düşer.
  SALE
  /// Satış iptali — stok geri eklenir.
  SALE_CANCEL
  /// Belgesiz elle giriş.
  MANUAL_IN
  /// Belgesiz elle çıkış.
  MANUAL_OUT
  /// Fire (bozulma, son kullanma tarihi geçmesi).
  WASTE
  /// Hasar / zayi (kırılma, dökülme).
  DAMAGE
  /// Sayım düzeltmesi. Yönü sayılan miktarla kayıtlı stoğun farkından çıkar.
  INVENTORY_ADJUSTMENT
}

/// Stok hareketi — `product_variants.stockQuantity` değişiminin TEK kaydı.
///
/// DEĞİŞMEZ TABLO (K-63): yalnız INSERT edilir. UPDATE ve DELETE veritabanı
/// RULE'u ile engellenir; `audit_logs` ile aynı yaklaşım. Bu yüzden
/// `updatedAt` ve `deletedAt` alanı YOKTUR — bir satırın hiç değişmeyeceği
/// biliniyorsa "ne zaman değişti" kolonu yanıltıcıdır.
///
/// `previousStock` ve `newStock` hesaplanabilir olsalar da SAKLANIR: altı ay
/// sonra "bu hareket sırasında rafta ne vardı" sorusunun yanıtı, aradaki
/// bütün hareketleri yeniden oynatmadan okunabilmelidir. Zincir tutarlılığı
/// (`newStock = previousStock ± quantity`) veritabanı CHECK'i ile zorlanır.
model StockMovement {
  id String @id @default(uuid()) @db.Uuid

  variantId String @db.Uuid
  /// Varyasyondan türetilir ama DENORMALİZE tutulur: ürün/kategori/marka
  /// bazlı hareket raporu ekstra join olmadan çalışsın.
  productId String @db.Uuid

  type      StockMovementType
  direction StockMovementDirection

  /// DAİMA POZİTİF. Yön `direction` alanındadır (K-58).
  quantity Decimal @db.Decimal(18, 3)

  /// Hareketten ÖNCEKİ ve SONRAKİ stok. Denetlenebilirlik için saklanır (K-59).
  previousStock Decimal @db.Decimal(18, 3)
  newStock      Decimal @db.Decimal(18, 3)

  /// Hareketi doğuran belge. Polimorfik: 'SALE' | ... (ileride 'PURCHASE').
  ///
  /// FK DEĞİLDİR. Farklı tablolara işaret edebilen bir kolona FK konulamaz;
  /// karşılığı, her belge türü için ayrı nullable FK kolonu açmaktır ve bu,
  /// tabloyu her yeni belge türünde genişletirdi.
  referenceType String? @db.VarChar(40)
  referenceId   String? @db.Uuid

  /// Elle girilen hareketlerde ZORUNLU (uygulama katmanında denetlenir).
  /// Sistem hareketlerinde belge numarasını içerir.
  description String? @db.VarChar(500)

  /// HASSAS: hareket anındaki birim maliyet snapshot'ı.
  ///
  /// Satış iptalinde stoğun DOĞRU maliyetle geri girmesi için saklanır:
  /// güncel alış fiyatı o günkü maliyeti temsil etmez (ARCHITECTURE §10.4).
  unitCost Decimal? @db.Decimal(18, 4)

  /// Sistem hareketlerinde de doldurulur (işlemi tetikleyen kullanıcı).
  createdById String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  /// onDelete/onUpdate: NoAction ZORUNLUDUR — `audit_logs` ile aynı gerekçe.
  ///
  /// Cascade veya SetNull, silme sırasında stock_movements üzerinde bir
  /// DELETE/UPDATE tetikler; tablo `stock_movements_no_*` RULE'ları ile
  /// değişmez olduğu için Postgres bu işlemi sessizce yutar ve ardından
  /// referans bütünlüğü hatası verir. NoAction ile kural nettir: stok
  /// geçmişi olan varyasyon hard delete EDİLEMEZ (uygulama zaten soft
  /// delete kullanır).
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product   Product        @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy User?          @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([variantId, createdAt])
  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("stock_movements")
}
