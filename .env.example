# =============================================================================
# Zirve Tarım — Ortam Değişkenleri
# -----------------------------------------------------------------------------
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
#     cp .env.example .env
#
# ÖNEMLİ: .env dosyası ASLA commit edilmez (.gitignore'da).
# Tüm değişkenler uygulama açılışında Zod ile doğrulanır
# (apps/api/src/config/env.validation.ts). Eksik veya geçersiz bir değer
# varsa uygulama BAŞLAMAZ — bu, yanlış yapılandırmayla üretime çıkmayı önler.
# =============================================================================

# -----------------------------------------------------------------------------
# GENEL
# -----------------------------------------------------------------------------

# Çalışma ortamı. İzinli değerler: development | test | production
NODE_ENV=development

# -----------------------------------------------------------------------------
# VERİTABANI (PostgreSQL)
# -----------------------------------------------------------------------------

# Docker Compose içinden çalışırken host adı `postgres` (servis adı) olmalıdır.
# Yerelde (docker dışında) API çalıştırıyorsanız `localhost` kullanın.
POSTGRES_USER=zirve
POSTGRES_PASSWORD=zirve_local_dev_password
POSTGRES_DB=zirve_tarim
POSTGRES_PORT=5432

# Prisma bağlantı adresi.
# Docker Compose içi:  postgresql://zirve:zirve_local_dev_password@postgres:5432/zirve_tarim?schema=public
# Yerel geliştirme:    postgresql://zirve:zirve_local_dev_password@localhost:5432/zirve_tarim?schema=public
DATABASE_URL=postgresql://zirve:zirve_local_dev_password@localhost:5432/zirve_tarim?schema=public

# -----------------------------------------------------------------------------
# API (NestJS)
# -----------------------------------------------------------------------------

# API'nin dinleyeceği port
API_PORT=4000

# Tüm uçların ortak ön eki. Sağlık ucu bunun DIŞINDADIR (/health).
API_PREFIX=api/v1

# Swagger arayüzünün yayınlanacağı yol. Üretimde SWAGGER_ENABLED=false yapın.
SWAGGER_PATH=docs
SWAGGER_ENABLED=true

# Virgülle ayrılmış izinli origin listesi. Joker (*) ÜRETİMDE KULLANILMAZ.
#
# ARTIK İKİ KÖKEN VAR: vitrin ve yönetim paneli ayrı repolar, ayrı uygulamalar.
# Yerelde Front :3000, Admin :3001 portunda çalışır. Üretimde kendi alan
# adlarını yazın (ör. https://zirvetarim.com,https://admin.zirvetarim.com).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Log seviyesi: fatal | error | warn | log | debug | verbose
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# GÜVENLİK — Sprint 2'de auth modülüyle birlikte kullanılmaya başlanacak
# -----------------------------------------------------------------------------

# En az 32 karakter. Üretim için rastgele üretin:  openssl rand -base64 48
# Aşağıdaki varsayılan değer NODE_ENV=production iken REDDEDİLİR.
JWT_ACCESS_SECRET=degistirin-en-az-32-karakter-olmali-dev-only
JWT_REFRESH_SECRET=degistirin-en-az-32-karakter-olmali-dev-only-2

# Token yaşam süreleri (ms formatı: 15m, 7d, 12h)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Müşteri (public) erişim jetonunun sırrı — Sprint 11.
# VARSAYILANI YOKTUR ve yönetici sırrıyla AYNI OLAMAZ: müşteri jetonu
# /admin/* uçlarında imza seviyesinde reddedilsin (audience ayrımına ek
# savunma katmanı — docs/ARCHITECTURE.md §8.4).
JWT_CUSTOMER_ACCESS_SECRET=degistirin-musteri-jetonu-icin-ayri-sir-dev-only

# Müşteri jetonlarının ömrü. Yöneticiden UZUNDUR: vitrinde oturumun sık sık
# yenilenmesi sepet akışını böler. Yönetim paneli hassas veri gösterdiği için
# kendi kısa sürelerini korur.
JWT_CUSTOMER_ACCESS_EXPIRES_IN=30m
JWT_CUSTOMER_REFRESH_EXPIRES_IN=30d

# Rate limit: TTL saniye cinsinden, LIMIT o süredeki azami istek sayısı
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Boşta kalan keep-alive bağlantısının kapatılma süresi (ms).
#
# ÖNÜNDEKİ REVERSE PROXY'NİN SÜRESİNDEN BÜYÜK OLMALIDIR. Node'un varsayılanı
# 5 saniyedir; nginx/ALB tipik olarak 60 saniye tutar. Node bağlantıyı önce
# kapatırsa, proxy tam o anda o bağlantıya istek göndermiş olabilir ve istemci
# 502 alır. Varsayılan 65000, 60 saniyelik bir proxy için güvenlidir.
KEEP_ALIVE_TIMEOUT=65000

# -----------------------------------------------------------------------------
# SEED — İLK SÜPER YÖNETİCİ
# -----------------------------------------------------------------------------

# prisma:seed bu bilgilerle ilk SUPER_ADMIN kullanıcısını oluşturur.
# Kullanıcı zaten varsa ŞİFRESİ EZİLMEZ (yönetici değiştirmiş olabilir).
# ÜRETİMDE varsayılan şifre REDDEDİLİR; güçlü bir değer verin:
#     openssl rand -base64 24
SEED_SUPER_ADMIN_EMAIL=admin@zirvetarim.local
SEED_SUPER_ADMIN_PASSWORD=ZirveTarim2026
SEED_SUPER_ADMIN_NAME=Sistem Yöneticisi

# Demo verisi yüklensin mi? (markalar, ürünler, müşteriler)
#
# Boş bırakılırsa: üretim DIŞINDA yüklenir, NODE_ENV=production iken YÜKLENMEZ.
# Sistem verisi (ayarlar, süper yönetici, ölçü birimleri, tarımsal taksonomi)
# her durumda yüklenir — onlar olmadan mağaza tek ürün bile oluşturamaz.
#
# Demo kayıtları UYDURMADIR ("AgroMax", kredi limitli "Ahmet Yılmaz"); gerçek
# bir mağaza veritabanına karışmaları geri alınması zor bir hatadır.
# Tanıtım/staging ortamında bilinçli olarak açmak için: true
SEED_DEMO_DATA=

# -----------------------------------------------------------------------------
# E-POSTA (Sprint 11)
# -----------------------------------------------------------------------------

# Posta sürücüsü:
#   log  -> e-postayı GÖNDERMEZ, gövdesini loglar. Geliştirme varsayılanı;
#           doğrulama bağlantısı log'dan kopyalanıp açılabilir.
#   smtp -> gerçek SMTP sunucusuna gönderir. SMTP_HOST zorunlu olur.
# ÜRETİMDE "log" REDDEDİLİR: doğrulama e-postası gitmezse kullanıcı hesabını
# doğrulayamaz ve geçmiş talepleri hesabına bağlanamaz.
MAIL_DRIVER=log

MAIL_FROM_ADDRESS=no-reply@zirvetarim.local
MAIL_FROM_NAME=Zirve Tarım

# MAIL_DRIVER=smtp iken kullanılır.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# E-postadaki doğrulama/sıfırlama bağlantılarının kök adresi.
# İsteğin Host başlığından TÜRETİLMEZ: saldırgan o başlığı değiştirip
# sıfırlama bağlantısını kendi alan adına yönlendirebilirdi.
# Front (vitrin) uygulamasinin adresi — artik AYRI repo: zirve-tarim-front
PUBLIC_WEB_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# İLERİDE — Sprint 1'de kullanılmıyor, docker-compose.yml'de yorum satırında
# -----------------------------------------------------------------------------

# REDIS_URL=redis://redis:6379
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=zirve-uploads
# S3_REGION=us-east-1
